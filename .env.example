# 複製成 .env 後填入自己的設定；不要提交真實 key
# 網頁也可直接選擇服務商、模型，再輸入 key（只保留於工作階段）

# 網頁預設服務商：deepseek / openai / xai / anthropic / gemini / openrouter
LLM_PROVIDER=deepseek

# 各服務商的網頁備用 key；使用頁面輸入時不必設定
# DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=your-openai-key
# XAI_API_KEY=your-xai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key
# OPENROUTER_API_KEY=your-openrouter-key

# 舊版命令列相容 API 設定（此範例使用 DeepSeek）
# 如改用 OpenAI，請同時改成官方 OpenAI 端點、模型及其 key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Investat MCP：在 Investat 帳號設定建立個人 token（帳號密碼不適用）
# 網頁也可輸入 token，只保留於目前工作階段，不寫入本機檔案
INVESTAT_MCP_TOKEN=ift_your-token-here

# SEC 公告：應用名稱及真實聯絡 email（只放本機 .env）
# SEC_USER_AGENT=news-finance-reader/1.0 contact your-email@example.com

# Telegram 頻道來源：Bot 加入頻道後，在「實時新聞」顯示新訊息，保留最近 7 天
# Token 只填入本機 .env，不要放進程式、Git 或網址列
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=-1001234567890

